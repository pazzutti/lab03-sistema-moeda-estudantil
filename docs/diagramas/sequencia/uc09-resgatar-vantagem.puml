@startuml uc09_resgatar_vantagem
' =====================================================================
' Sistema de Moeda Estudantil
' Diagrama de Sequencia - UC09 Resgatar vantagem (HU08)
' Fonte versionada em docs/diagramas/sequencia/uc09-resgatar-vantagem.puml
' Inclui UC10 (detalhado em uc10-enviar-cupom-por-email.puml)
' =====================================================================

skinparam shadowing false
autonumber

actor Aluno
participant Frontend
participant "TransacoesController" as Controller
participant "TransacoesService" as Service
participant "NotificacoesService" as Notificacoes
box "Camada de Repository (TypeORM)" #FFF8DC
  participant "Repository<Vantagem>" as VantRepo
  participant "Repository<Aluno>" as AlunoRepo
  participant "Repository<Resgate>" as ResgateRepo
end box
database "Banco de Dados" as BD

Aluno -> Frontend : clica em "Resgatar" e confirma
Frontend -> Controller : POST /transacoes/resgates { vantagemId }
Controller -> Service : resgatarVantagem(usuario, dto)

alt usuário não é aluno
  Service --> Controller : ForbiddenException
  Controller --> Frontend : 403 Forbidden
else aluno
  group transação do banco (EntityManager)
    Service -> VantRepo : findOneBy({ id, ativa: true })
    VantRepo -> BD : SELECT vantagem
    BD --> VantRepo : linha ou nada
    VantRepo --> Service : vantagem ou null
    alt vantagem inexistente ou removida
      Service --> Controller : NotFoundException
      Controller --> Frontend : 404 Not Found
      Frontend --> Aluno : exibe erro
    else vantagem ativa
      Service -> AlunoRepo : findOneBy({ id })
      AlunoRepo -> BD : SELECT aluno
      BD --> AlunoRepo : linha
      AlunoRepo --> Service : aluno
      Service -> AlunoRepo : createQueryBuilder().update()\nsaldo = saldo - custo WHERE saldo >= custo
      AlunoRepo -> BD : UPDATE aluno
      BD --> AlunoRepo : linhas afetadas
      AlunoRepo --> Service : affected
      alt saldo insuficiente (0 linhas)
        Service --> Controller : BadRequestException
        Controller --> Frontend : 400 Bad Request
        Frontend --> Aluno : exibe erro de saldo
      else debitado
        loop até achar código livre
          Service -> Service : gerarCodigoCupom()
          Service -> ResgateRepo : existsBy({ codigoCupom })
          ResgateRepo -> BD : SELECT resgate
          BD --> ResgateRepo : resultado
          ResgateRepo --> Service : true / false
        end
        Service -> ResgateRepo : save(resgate: custo, código do cupom)
        ResgateRepo -> BD : INSERT resgate
        BD --> Service : commit
        Service ->> Notificacoes : notificarResgate(dados)\n(sem await, ver UC10)
        Service --> Controller : resgate, código e saldo
        Controller --> Frontend : 201 Created
        Frontend --> Aluno : exibe código do cupom e novo saldo
      end
    end
  end
end

@enduml
