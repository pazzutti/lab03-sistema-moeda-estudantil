@startuml uc05_consultar_extrato
' =====================================================================
' Sistema de Moeda Estudantil
' Diagrama de Sequencia - UC05 Consultar extrato (HU06 / HU10)
' Fonte versionada em docs/diagramas/sequencia/uc05-consultar-extrato.puml
' =====================================================================

skinparam shadowing false
autonumber

actor "Aluno / Professor" as Usuario
participant Frontend
participant "TransacoesController" as Controller
participant "TransacoesService" as Service
box "Camada de Repository (TypeORM)" #FFF8DC
  participant "Repository<Professor>\n/ Repository<Aluno>" as PerfilRepo
  participant "Repository<EnvioMoedas>" as EnvioRepo
  participant "Repository<CreditoSemestral>\n/ Repository<Resgate>" as HistRepo
end box
database "Banco de Dados" as BD

note over PerfilRepo, HistRepo : Acessados pelo EntityManager do DataSource\n(manager.findOneBy / manager.find)

Usuario -> Frontend : abre /extrato
Frontend -> Controller : GET /transacoes/extrato
Controller -> Service : consultarExtrato(usuario)

alt usuário é professor
  Service -> PerfilRepo : findOneBy(Professor, { id })
  PerfilRepo -> BD : SELECT professor
  BD --> PerfilRepo : linha
  PerfilRepo --> Service : professor (saldo)
  Service -> EnvioRepo : find({ professor: id }) com aluno
  EnvioRepo -> BD : SELECT envio_moedas JOIN aluno
  BD --> EnvioRepo : linhas
  EnvioRepo --> Service : envios
  Service -> HistRepo : find(CreditoSemestral, { professor: id })
  HistRepo -> BD : SELECT credito_semestral
  BD --> HistRepo : linhas
  HistRepo --> Service : créditos
  Service -> Service : junta ENVIO + CREDITO_SEMESTRAL\nem ordem decrescente de data
else usuário é aluno
  Service -> PerfilRepo : findOneBy(Aluno, { id })
  PerfilRepo -> BD : SELECT aluno
  BD --> PerfilRepo : linha
  PerfilRepo --> Service : aluno (saldo)
  Service -> EnvioRepo : find({ aluno: id }) com professor
  EnvioRepo -> BD : SELECT envio_moedas JOIN professor
  BD --> EnvioRepo : linhas
  EnvioRepo --> Service : recebimentos
  Service -> HistRepo : find(Resgate, { aluno: id }) com vantagem e empresa
  HistRepo -> BD : SELECT resgate JOIN vantagem, empresa
  BD --> HistRepo : linhas
  HistRepo --> Service : resgates
  Service -> Service : junta RECEBIMENTO + RESGATE\nem ordem decrescente de data
else empresa parceira
  Service --> Controller : ForbiddenException
  Controller --> Frontend : 403 Forbidden
  Frontend --> Usuario : exibe erro
end

Service --> Controller : { saldo, transacoes }
Controller --> Frontend : 200 OK
Frontend --> Usuario : exibe saldo e histórico

@enduml
