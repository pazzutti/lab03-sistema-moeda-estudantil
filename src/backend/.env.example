# Copie para .env e ajuste. Todas as variaveis sao opcionais em desenvolvimento.

# Porta da API (o frontend espera http://localhost:3000).
PORT=3000

# Arquivo do banco SQLite. Use ":memory:" para recriar o banco vazio a cada reinicio.
DB_DATABASE=moeda.sqlite

# Segredo de assinatura dos tokens JWT. Obrigatorio trocar fora do ambiente local.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Mailtrap. Sem MAILTRAP_API_TOKEN, os emails so aparecem no log do backend.
MAILTRAP_API_TOKEN=
# Id da inbox do Email Sandbox (Mailtrap > Sandboxes): captura os emails sem
# exigir dominio verificado. Deixe vazio para enviar de verdade (Email API).
MAILTRAP_TEST_INBOX_ID=
# Remetente; no envio de verdade precisa ser de um dominio verificado.
MAIL_FROM=noreply@moedaestudantil.com
# Intervalo entre emails (ms). O padrao atende ao limite do plano gratuito da Sandbox.
# MAILTRAP_INTERVALO_MS=11000
