@startuml uc04_manter_dados_cadastrais
' =====================================================================
' Sistema de Moeda Estudantil
' Diagrama de Sequencia - UC04 Manter dados cadastrais (HU04 / HU12)
' Fonte versionada em docs/diagramas/sequencia/uc04-manter-dados-cadastrais.puml
' O fluxo e o mesmo para aluno (/alunos) e empresa (/empresas);
' o diagrama usa o aluno como exemplo.
' =====================================================================

skinparam shadowing false
autonumber

actor "Aluno / Empresa" as Usuario
participant Frontend
participant "AlunosController\n(EmpresasController)" as Controller
participant "AlunosService\n(EmpresasService)" as Service
participant "UsuariosService" as Usuarios
box "Camada de Repository (TypeORM)" #FFF8DC
  participant "Repository<Aluno>\n(Repository<EmpresaParceira>)" as PerfilRepo
  participant "Repository<Usuario>" as UsuarioRepo
end box
database "Banco de Dados" as BD

== Visualizar ==
Usuario -> Frontend : abre /perfil
Frontend -> Controller : GET /alunos/{id}
Controller -> Service : buscar(id)
Service -> PerfilRepo : findOneBy({ id })
PerfilRepo -> BD : SELECT aluno JOIN usuario, instituicao
BD --> PerfilRepo : linha
PerfilRepo --> Service : aluno
Service --> Controller : aluno
Controller --> Frontend : 200 OK
Frontend --> Usuario : exibe dados (CPF somente leitura)

== Editar ==
Usuario -> Frontend : altera campos e salva
Frontend -> Controller : PATCH /alunos/{id}
note right of Controller : UpdateAlunoDto não aceita CPF
Controller -> Service : atualizar(id, dto, usuarioLogado)
alt não é o próprio cadastro
  Service --> Controller : ForbiddenException
  Controller --> Frontend : 403 Forbidden
  Frontend --> Usuario : exibe erro
else próprio cadastro
  Service -> PerfilRepo : findOneBy({ id })
  PerfilRepo -> BD : SELECT aluno
  BD --> PerfilRepo : linha
  PerfilRepo --> Service : aluno
  group transação do banco (EntityManager)
    Service -> Usuarios : atualizar(manager, usuario, { email, senha })
    Usuarios -> UsuarioRepo : existsBy({ email, id != atual })
    UsuarioRepo -> BD : SELECT usuario
    BD --> UsuarioRepo : resultado
    UsuarioRepo --> Usuarios : true / false
    alt email em uso
      Usuarios --> Service : ConflictException (email)
      Service --> Controller : rollback
      Controller --> Frontend : 409 Conflict
      Frontend --> Usuario : exibe erro no campo email
    else ok
      Usuarios -> UsuarioRepo : save(usuario) (nova senha com hash)
      UsuarioRepo -> BD : UPDATE usuario
      Service -> PerfilRepo : save(aluno)
      PerfilRepo -> BD : UPDATE aluno
      BD --> Service : commit
      Service --> Controller : aluno atualizado
      Controller --> Frontend : 200 OK
      Frontend --> Usuario : exibe confirmação
    end
  end
end

== Excluir ==
Usuario -> Frontend : clica em "Excluir conta"
Frontend --> Usuario : pede confirmação
Usuario -> Frontend : confirma
Frontend -> Controller : DELETE /alunos/{id}
Controller -> Service : remover(id, usuarioLogado)
Service -> Service : garante que é o próprio cadastro
Service -> PerfilRepo : findOneBy({ id })
PerfilRepo --> Service : aluno
group transação do banco (EntityManager)
  Service -> PerfilRepo : delete({ id })
  PerfilRepo -> BD : DELETE aluno
  Service -> UsuarioRepo : delete({ id })
  UsuarioRepo -> BD : DELETE usuario
  BD --> Service : commit
end
Service --> Controller : ok
Controller --> Frontend : 204 No Content
Frontend -> Frontend : apaga sessão
Frontend --> Usuario : redireciona para a página inicial

@enduml
