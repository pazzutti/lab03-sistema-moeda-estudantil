@startuml uc10_enviar_cupom_por_email
' =====================================================================
' Sistema de Moeda Estudantil
' Diagrama de Sequencia - UC10 Enviar cupom por email (HU08 / HU15)
' Fonte versionada em docs/diagramas/sequencia/uc10-enviar-cupom-por-email.puml
' Incluido por UC09: roda depois do commit do resgate
' =====================================================================

skinparam shadowing false
autonumber

participant "TransacoesService" as Transacoes
participant "NotificacoesService" as Notificacoes
participant "gerarQrCodeCupom" as QrCode
participant "emailTemplates" as Templates
participant "EmailService" as EmailSrv
participant "Mailtrap" as Mailtrap <<sistema externo>>
actor Aluno
actor "Empresa Parceira" as Empresa

Transacoes ->> Notificacoes : notificarResgate(aluno, empresa, vantagem,\ncusto, codigo, saldoAluno)

Notificacoes -> QrCode : gerarQrCodeCupom(codigo)
alt imagem gerada
  QrCode --> Notificacoes : PNG do QR Code
else falha
  QrCode --> Notificacoes : erro
  Notificacoes -> Notificacoes : registra no log\n(email segue só com o código)
end

par cupom do aluno
  Notificacoes -> Templates : cupomAluno(vantagem, empresa, custo, codigo,\nsaldo, qrCodeCid)
  Templates --> Notificacoes : html com <img src="cid:qrcode-{codigo}">
  Notificacoes -> EmailSrv : enviar("Seu cupom {codigo}: {vantagem}",\nimagens = [QR Code embutido])
else conferência da empresa
  Notificacoes -> Templates : conferenciaEmpresa(aluno, vantagem, custo, codigo)
  Templates --> Notificacoes : html
  Notificacoes -> EmailSrv : enviar("Resgate para conferir: cupom {codigo}")
end

loop para cada email (fila com intervalo do Mailtrap)
  alt MAILTRAP_API_TOKEN configurado
    EmailSrv -> Mailtrap : client.send(email)
    alt entregue
      Mailtrap --> EmailSrv : ok
    else falha
      Mailtrap --> EmailSrv : erro
      EmailSrv --> Notificacoes : erro
      Notificacoes -> Notificacoes : registra no log\n(não desfaz o resgate)
    end
  else ambiente local sem token
    EmailSrv -> EmailSrv : escreve o email no log [DEV MAIL]
  end
end

opt emails entregues
  Mailtrap ->> Aluno : email com o QR Code e o código do cupom
  Mailtrap ->> Empresa : email com o mesmo código,\nnome do aluno e vantagem
end

== Troca presencial ==
Aluno -> Empresa : apresenta o QR Code (ou o código) do cupom
Empresa -> Empresa : lê o QR Code e confere com o código\ndo email de conferência

@enduml
