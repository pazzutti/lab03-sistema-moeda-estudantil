@startuml uc12_creditar_moedas_semestrais
' =====================================================================
' Sistema de Moeda Estudantil
' Diagrama de Sequencia - UC12 Creditar moedas semestrais (HU16)
' Fonte versionada em docs/diagramas/sequencia/uc12-creditar-moedas-semestrais.puml
' =====================================================================

skinparam shadowing false
autonumber

actor "Agendador\n(setInterval 1h)" as Agendador <<sistema>>
participant "ProfessoresService" as Service
participant "semestre.ts" as Semestre
box "Camada de Repository (TypeORM)" #FFF8DC
  participant "Repository<Professor>" as ProfRepo
  participant "Repository<CreditoSemestral>" as CreditoRepo
end box
database "Banco de Dados" as BD

note over Agendador : Executa ao iniciar a aplicação\n(onApplicationBootstrap) e depois a cada hora

Agendador -> Service : creditarSemestre(agora)
Service -> Semestre : semestreDaRecarga(agora)

alt fora da 1ª semana de fevereiro ou agosto
  Semestre --> Service : null
  Service --> Agendador : nada a fazer
else dentro da janela de recarga
  Semestre --> Service : "AAAA.1" ou "AAAA.2"
  Service -> ProfRepo : find()
  ProfRepo -> BD : SELECT professor
  BD --> ProfRepo : linhas
  ProfRepo --> Service : professores

  loop para cada professor
    group transação do banco (EntityManager)
      Service -> CreditoRepo : existsBy({ professor, semestre })
      CreditoRepo -> BD : SELECT credito_semestral
      BD --> CreditoRepo : resultado
      CreditoRepo --> Service : true / false
      alt já recebeu
        Service -> Service : ignora (crédito único por semestre)
      else ainda não recebeu
        Service -> CreditoRepo : insert({ professor, semestre, 1.000 })
        CreditoRepo -> BD : INSERT credito_semestral
        Service -> ProfRepo : increment(saldo, 1.000) (acumulável)
        ProfRepo -> BD : UPDATE professor
        BD --> Service : commit
      end
    end
  end
  Service --> Agendador : concluído
end

opt erro em alguma verificação
  Agendador -> Agendador : registra "Falha na recarga semestral" no log\ne tenta de novo na próxima hora
end

@enduml
